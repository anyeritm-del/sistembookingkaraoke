# Copy to .env for local use. On Vercel, set these in Project Settings > Environment Variables.

# PIN for the first login as user "admin" while the Users tab is empty.
# It becomes that account's PIN; change it after the first login.
ADMIN_PIN=
# Random secret, min 32 chars: openssl rand -base64 48
SESSION_SECRET=
# Random secret, min 32 chars, mixed into PIN hashes: openssl rand -base64 48
# NEVER change it after users exist: every saved PIN would stop working.
PIN_PEPPER=
# Secret for room TVs, min 16 chars: openssl rand -hex 16
TV_KEY=
# Business time zone (default WIB)
APP_TIMEZONE=Asia/Jakarta

# Google Sheets
STORE=sheets
SPREADSHEET_ID=
# Service account key: raw JSON, or base64 of the JSON (base64 -i key.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local only: path to the key file instead of the JSON above
GOOGLE_SERVICE_ACCOUNT_FILE=

# Android TV app release signing (local build only, not for Vercel).
# Keystore lives outside the repo; back it up with these passwords.
KARAOKE_TV_KEYSTORE=
KARAOKE_TV_STORE_PASSWORD=
KARAOKE_TV_KEY_ALIAS=karaoke-tv
KARAOKE_TV_KEY_PASSWORD=
