# Copy to .env for local use. On Vercel, set these in Project Settings > Environment Variables.

# Staff login PIN (6+ digits recommended)
ADMIN_PIN=
# Random secret, min 32 chars: openssl rand -base64 48
SESSION_SECRET=
# Secret for room TVs, min 16 chars: openssl rand -hex 16
TV_KEY=
# Business time zone (default WIB)
APP_TIMEZONE=Asia/Jakarta

# Google Sheets
STORE=sheets
SPREADSHEET_ID=
# Service account key: raw JSON, or base64 of the JSON (base64 -i key.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local only: path to the key file instead of the JSON above
GOOGLE_SERVICE_ACCOUNT_FILE=
